# Copy to .env. Everything is optional.
# Change these if 4317, 4318 or 18888 are already in use:
# LAB_OTLP_GRPC_PORT=4317
# LAB_OTLP_HTTP_PORT=4318
# LAB_UI_PORT=18888
# Keep the archive in a host folder instead of a Docker volume. On Linux the files are owned
# by the collector's uid (10001); `docker compose cp otel-collector:/data/archive.jsonl .` always works.
# LAB_DATA_DIR=./data
# Tag added by the collector to everything it receives:
# LAB_ENVIRONMENT=lab
